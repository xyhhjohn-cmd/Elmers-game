<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elmers Game</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    touch-action: none;
}

body {
    overflow: hidden;
    background: #111;
    font-family: Arial, sans-serif;
}

#game {
    width: 100vw;
    height: 100vh;
    position: relative;
    overflow: hidden;
    background: #27833b;
}

/* ROAD */
#road {
    position: absolute;
    width: 55%;
    min-width: 280px;
    height: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #333;
    border-left: 8px solid white;
    border-right: 8px solid white;
}

/* ROAD LINES */
.roadLine {
    position: absolute;
    width: 10px;
    height: 80px;
    background: white;
    left: 50%;
    transform: translateX(-50%);
}

/* HUD */
#hud {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 20;
    color: white;
    font-size: 18px;
    font-weight: bold;
    text-shadow: 2px 2px 3px black;
}

#hud div {
    margin-bottom: 6px;
}

/* CAR */
.car {
    position: absolute;
    width: 48px;
    height: 78px;
    border-radius: 10px;
    z-index: 10;
}

/* PLAYER */
#player {
    background: red;
    bottom: 110px;
    box-shadow:
        inset 8px 0 #a00000,
        inset -8px 0 #a00000;
}

/* CAR WINDOW */
.car::before {
    content: "";
    position: absolute;
    width: 30px;
    height: 25px;
    left: 9px;
    top: 9px;
    border-radius: 5px;
    background: #9eeaff;
}

/* ENEMY */
.enemy {
    background: #1976d2;
    box-shadow:
        inset 8px 0 #0d47a1,
        inset -8px 0 #0d47a1;
}

/* CONTROLS */
#controls {
    position: absolute;
    bottom: 20px;
    left: 0;
    width: 100%;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    padding: 0 25px;
}

.control {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    background: rgba(0,0,0,.55);
    border: 3px solid white;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    user-select: none;
}

/* START SCREEN */
#startScreen {
    position: absolute;
    inset: 0;
    z-index: 100;
    background: rgba(0,0,0,.88);
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

#startScreen h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

#startScreen p {
    margin-bottom: 12px;
}

button {
    border: none;
    border-radius: 10px;
    padding: 15px 30px;
    background: red;
    color: white;
    font-size: 20px;
    font-weight: bold;
}

/* GAME OVER */
#gameOver {
    position: absolute;
    inset: 0;
    z-index: 90;
    background: rgba(0,0,0,.85);
    color: white;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

#gameOver h2 {
    font-size: 40px;
    margin-bottom: 15px;
}

#gameOver p {
    font-size: 20px;
    margin-bottom: 20px;
}
</style>
</head>

<body>

<div id="game">

    <div id="road">

        <div class="roadLine" style="top:-100px;"></div>
        <div class="roadLine" style="top:100px;"></div>
        <div class="roadLine" style="top:300px;"></div>
        <div class="roadLine" style="top:500px;"></div>
        <div class="roadLine" style="top:700px;"></div>

    </div>

    <div id="hud">
        <div>🏁 ELMERS GAME</div>
        <div>Score: <span id="score">0</span></div>
        <div>Speed: <span id="speed">1</span></div>
    </div>

    <div id="player" class="car"></div>

    <div id="controls">
        <div class="control" id="left">⬅️</div>
        <div class="control" id="right">➡️</div>
    </div>

    <!-- START -->
    <div id="startScreen">

        <h1>🏎️ ELMERS GAME</h1>

        <p>2D Racing Game</p>
        <p>Avoid the enemy cars!</p>

        <button id="startButton">
            START RACE
        </button>

    </div>

    <!-- GAME OVER -->
    <div id="gameOver">

        <h2>💥 GAME OVER</h2>

        <p>
            Score:
            <span id="finalScore">0</span>
        </p>

        <button id="restartButton">
            RACE AGAIN
        </button>

    </div>

</div>

<script>

/* =========================
   VARIABLES
========================= */

const game = document.getElementById("game");
const road = document.getElementById("road");
const player = document.getElementById("player");

const scoreDisplay =
    document.getElementById("score");

const speedDisplay =
    document.getElementById("speed");

const startScreen =
    document.getElementById("startScreen");

const gameOver =
    document.getElementById("gameOver");

const finalScore =
    document.getElementById("finalScore");

const startButton =
    document.getElementById("startButton");

const restartButton =
    document.getElementById("restartButton");

const leftButton =
    document.getElementById("left");

const rightButton =
    document.getElementById("right");

let playerX = 0;

let enemies = [];

let score = 0;

let gameSpeed = 5;

let running = false;

let roadLeft = 0;

let roadRight = 0;

let lastEnemyTime = 0;


/* =========================
   START GAME
========================= */

function startGame() {

    startScreen.style.display = "none";
    gameOver.style.display = "none";

    enemies.forEach(e => {
        e.element.remove();
    });

    enemies = [];

    score = 0;

    gameSpeed = 5;

    scoreDisplay.textContent = "0";
    speedDisplay.textContent = "1";

    const roadRect =
        road.getBoundingClientRect();

    roadLeft = roadRect.left;
    roadRight = roadRect.right;

    playerX =
        roadLeft +
        (roadRight - roadLeft) / 2 -
        player.offsetWidth / 2;

    player.style.left =
        playerX + "px";

    running = true;

    lastEnemyTime = performance.now();

    requestAnimationFrame(gameLoop);
}


/* =========================
   GAME LOOP
========================= */

function gameLoop(time) {

    if (!running) return;

    moveRoad();

    moveEnemies();

    checkCollision();

    createEnemies(time);

    requestAnimationFrame(gameLoop);
}


/* =========================
   ROAD MOVEMENT
========================= */

function moveRoad() {

    const lines =
        document.querySelectorAll(".roadLine");

    lines.forEach(line => {

        let y =
            parseFloat(line.style.top);

        y += gameSpeed;

        if (y > window.innerHeight) {
            y = -100;
        }

        line.style.top =
            y + "px";
    });
}


/* =========================
   CREATE ENEMIES
========================= */

function createEnemies(time) {

    if (time - lastEnemyTime < 1000)
        return;

    lastEnemyTime = time;

    const enemy =
        document.createElement("div");

    enemy.className =
        "car enemy";

    const roadWidth =
        roadRight - roadLeft;

    const maxX =
        roadRight -
        enemy.offsetWidth -
        15;

    const minX =
        roadLeft + 15;

    const randomX =
        minX +
        Math.random() *
        (maxX - minX);

    enemy.style.left =
        randomX + "px";

    enemy.style.top =
        "-100px";

    game.appendChild(enemy);

    enemies.push({

        element: enemy,

        y: -100,

        speed:
            gameSpeed +
            Math.random() * 2

    });
}


/* =========================
   MOVE ENEMIES
========================= */

function moveEnemies() {

    enemies.forEach((enemy, index) => {

        enemy.y += enemy.speed;

        enemy.element.style.top =
            enemy.y + "px";

        if (
            enemy.y >
            window.innerHeight + 100
        ) {

            enemy.element.remove();

            enemies.splice(index, 1);

            score++;

            scoreDisplay.textContent =
                score;

            /* Increase difficulty */

            if (score % 10 === 0) {

                gameSpeed += 0.7;

                speedDisplay.textContent =
                    Math.floor(gameSpeed - 4);
            }
        }
    });
}


/* =========================
   COLLISION
========================= */

function checkCollision() {

    const playerRect =
        player.getBoundingClientRect();

    for (const enemy of enemies) {

        const enemyRect =
            enemy.element.getBoundingClientRect();

        if (

            playerRect.left <
            enemyRect.right &&

            playerRect.right >
            enemyRect.left &&

            playerRect.top <
            enemyRect.bottom &&

            playerRect.bottom >
            enemyRect.top

        ) {

            endGame();

            break;
        }
    }
}


/* =========================
   MOVE LEFT
========================= */

function moveLeft() {

    if (!running) return;

    playerX -= 30;

    if (
        playerX <
        roadLeft + 10
    ) {

        playerX =
            roadLeft + 10;
    }

    player.style.left =
        playerX + "px";
}


/* =========================
   MOVE RIGHT
========================= */

function moveRight() {

    if (!running) return;

    playerX += 30;

    if (
        playerX >
        roadRight -
        player.offsetWidth -
        10
    ) {

        playerX =
            roadRight -
            player.offsetWidth -
            10;
    }

    player.style.left =
        playerX + "px";
}


/* =========================
   TOUCH
========================= */

leftButton.addEventListener(
    "touchstart",
    function(e) {

        e.preventDefault();

        moveLeft();

    }
);

rightButton.addEventListener(
    "touchstart",
    function(e) {

        e.preventDefault();

        moveRight();

    }
);


/* =========================
   MOUSE
========================= */

leftButton.addEventListener(
    "mousedown",
    moveLeft
);

rightButton.addEventListener(
    "mousedown",
    moveRight
);


/* =========================
   KEYBOARD
========================= */

document.addEventListener(
    "keydown",
    function(e) {

        if (e.key === "ArrowLeft") {

            moveLeft();

        }

        if (e.key === "ArrowRight") {

            moveRight();

        }

    }
);


/* =========================
   GAME OVER
========================= */

function endGame() {

    running = false;

    finalScore.textContent =
        score;

    gameOver.style.display =
        "flex";
}


/* =========================
   BUTTONS
========================= */

startButton.addEventListener(
    "click",
    startGame
);

restartButton.addEventListener(
    "click",
    startGame
);

</script>

</body>
</html>
